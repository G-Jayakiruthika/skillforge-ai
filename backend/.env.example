# SkillForge AI — environment configuration
#
# Copy to backend/.env and fill in what you need. Every value is optional: with
# an empty file the app runs locally with sensible, safe defaults.
# backend/.env is git-ignored. Never commit a real key.

# ---------------------------------------------------------------- deployment
# Set to 1 when the app is reachable from outside localhost. This turns OFF the
# interactive API docs, turns OFF the passwordless demo session, and makes the
# app refuse to start with an insecure configuration. Always 1 in production.
SKILLFORGE_PUBLIC=0

# Never set this in production. Leaving it unset keeps tracebacks out of
# responses; FastAPI's own debug flag is hard-coded off regardless.
SKILLFORGE_DEBUG=0

# Browser origins allowed to call the API, comma separated. Never "*".
# Example: https://skillforge.example.com,https://www.skillforge.example.com
SKILLFORGE_CORS_ORIGINS=

# Signing key for session cookies. REQUIRED in production: set a long random
# value and keep it stable, or every deploy signs everyone out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset, a key is generated into backend/data/.secret, which is lost on
# hosts with an ephemeral disk.
SKILLFORGE_SECRET=

# How long a sign-in lasts, in hours. 1 to 720. Default 72.
SKILLFORGE_SESSION_HOURS=72

# ------------------------------------------------------------------ database
# Path to the SQLite file. Default: backend/data/skillforge.db
# On a host with ephemeral disk, point this at a mounted volume that survives
# redeploys, or migrate to Postgres — see docs/DEPLOYMENT.md.
SKILLFORGE_DB=

# ---------------------------------------------------------------- privileges
# The one email address allowed to hold the admin role. Set this before the
# first sign-up in production; otherwise the first account created becomes
# admin, which is convenient locally and wrong on a public server.
SKILLFORGE_ADMIN_EMAIL=

# ------------------------------------------------------------------- Gemini
# Optional. Used only for mentor wording, explanation grading, resume
# extraction and mentor chat — and only after the user turns on AI processing
# in Data Consent. Every agent works without it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
